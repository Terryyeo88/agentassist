# Credentials - NEVER commit these
.env
config/.env
keys/
*.pem

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/

# Temp
/tmp/
*.tmp
cookies.txt

# Client configs — only the placeholder and the public demo instance are committed
config/clients/*.yaml
!config/clients/example.yaml
!config/clients/sbodemosg.yaml
!config/clients/xero_demo.yaml
!config/clients/extract_demo.yaml

# Generated outputs
audit/
# Durable per-client decision store (t-decision-persistence) — runtime data, never
# committed. LOAD-BEARING: the frozen /review tests assume this store is absent in a
# fresh checkout/CI; committing a ledger would change frozen-demo test output.
decisions/
exploration-notes/t1.4-reports/
exploration-notes/t1.6-tool-outputs/*.json
*.pdf
!tests/fixtures/documents/*.pdf
# Knowledge-base reference PDFs are TRACKED by declaration (θ ruling,
# 2026-07-19): the manifest (knowledge-base/sources.md) asserts local paths
# resolve in a CLONE, so the corpus must be in git — the same negation idiom
# the fixtures line above already uses. Historical force-adds made the KB the
# undocumented anomaly; this makes tracking the default for exactly the files
# the manifest governs. "In the repo" has three meanings — on disk, tracked,
# present in a clone — and the manifest's local_path column means CLONED.
!knowledge-base/**/*.pdf
*-specialist.json

# Claude Code per-project memory (local only, not for version control)
memory/

!knowledge-base/etaxguide_gst_invoicenow_requirement.pdf