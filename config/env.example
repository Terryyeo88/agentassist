# SAP Business One Service Layer Connection
# Copy this to .env at repo root and fill in your actual values
# NEVER commit .env to git

# Client configuration: tells AgentAssist which config/clients/<id>.yaml to load.
# The YAML holds connection details; secrets stay in the variables below.
CLIENT_ID=sbodemosg

SAP_USERNAME=your_username
SAP_PASSWORD=your_password

# SAP_BASE_URL, SAP_COMPANY_DB, SAP_SSL_VERIFY are now read from the YAML config
# (config/clients/<CLIENT_ID>.yaml) and no longer need to be set here.
# They are kept below commented out for reference during migration only.
# SAP_BASE_URL=https://your-sap-host:50000/b1s/v2
# SAP_COMPANY_DB=YOUR_COMPANY_DB
# SAP_SSL_VERIFY=true
