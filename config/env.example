# SAP Business One Service Layer Connection
# Copy this to .env at repo root and fill in your actual values
# NEVER commit .env to git

SAP_BASE_URL=https://your-sap-host:50000/b1s/v2
SAP_COMPANY_DB=YOUR_COMPANY_DB
SAP_USERNAME=your_username
SAP_PASSWORD=your_password

# SSL certificate verification for SAP B1 Service Layer.
# Set to false ONLY for demo against SBODEMOSG with self-signed cert.
# Production deployments MUST use true with a properly signed certificate,
# or implement certificate pinning. See exploration-notes/security-decisions.md.
SAP_SSL_VERIFY=true
